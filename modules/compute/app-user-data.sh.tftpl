#!/bin/bash
set -eux

dnf install -y nodejs git

rm -rf /opt/teamops
mkdir -p /opt/teamops

for attempt in 1 2 3 4 5; do
  if git clone --depth 1 --branch main https://github.com/pahanattx/aws-3tier-infra.git /opt/teamops/repo; then
    break
  fi

  rm -rf /opt/teamops/repo
  sleep 5
done

test -f /opt/teamops/repo/app/backend/server.js
test -f /opt/teamops/repo/app/backend/db.js
test -f /opt/teamops/repo/app/backend/package.json
test -f /opt/teamops/repo/app/frontend/index.html

cd /opt/teamops/repo/app/backend

if [ -f package-lock.json ]; then
  npm ci --omit=dev
else
  npm install --omit=dev
fi

npm install --omit=dev --no-save --package-lock=false @aws-sdk/client-secrets-manager

cat > /opt/teamops/repo/app/backend/start-with-secret.js <<'NODE'
"use strict";

const {
  SecretsManagerClient,
  GetSecretValueCommand
} = require("@aws-sdk/client-secrets-manager");

async function start() {
  const region = process.env.AWS_REGION || "us-east-1";
  const secretArn = process.env.DB_SECRET_ARN;

  if (!secretArn) {
    throw new Error("DB_SECRET_ARN is not configured");
  }

  const client = new SecretsManagerClient({ region });

  const response = await client.send(
    new GetSecretValueCommand({
      SecretId: secretArn
    })
  );

  const secret = JSON.parse(response.SecretString || "{}");

  if (!secret.username || !secret.password) {
    throw new Error("RDS secret does not contain username/password");
  }

  process.env.DB_USER = secret.username;
  process.env.DB_PASSWORD = secret.password;
  process.env.DB_PORT = process.env.DB_PORT || "3306";
  process.env.DB_NAME = process.env.DB_NAME || "teamops";

  require("./server");
}

start().catch((error) => {
  console.error("TeamOps startup failed:", error.message);
  process.exit(1);
});
NODE

cat > /etc/systemd/system/teamops-api.service <<SERVICE
[Unit]
Description=TeamOps v4 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/teamops/repo/app/backend
ExecStart=/usr/bin/node /opt/teamops/repo/app/backend/start-with-secret.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=AWS_REGION=us-east-1
Environment=PORT=4000
Environment=DB_HOST=${db_endpoint}
Environment=DB_PORT=3306
Environment=DB_NAME=teamops
Environment=DB_SECRET_ARN=${rds_secret_arn}
Environment=COOKIE_SECURE=false

[Install]
WantedBy=multi-user.target
SERVICE

chown -R ec2-user:ec2-user /opt/teamops

systemctl daemon-reload
systemctl enable teamops-api
systemctl restart teamops-api
