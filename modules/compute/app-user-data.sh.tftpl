#!/bin/bash
set -eux

dnf install -y nodejs

mkdir -p /opt/teamops
cd /opt/teamops

cat > package.json <<'PACKAGE'
{
  "name": "teamops-api",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "express": "^5.0.0",
    "mysql2": "^3.0.0"
  }
}
PACKAGE

npm install --omit=dev

cat > server.js <<'NODE'
const express = require('express');
const mysql = require('mysql2/promise');
const {
  SecretsManagerClient,
  GetSecretValueCommand
} = require('@aws-sdk/client-secrets-manager');

const app = express();
app.use(express.json());

let pool;

async function initialiseDatabase() {
  const client = new SecretsManagerClient({
    region: process.env.AWS_REGION
  });

  const response = await client.send(
    new GetSecretValueCommand({
      SecretId: process.env.DB_SECRET_ARN
    })
  );

  const secret = JSON.parse(response.SecretString);

  pool = mysql.createPool({
    host: process.env.DB_HOST,
    port: 3306,
    user: secret.username,
    password: secret.password,
    database: 'teamops',
    waitForConnections: true,
    connectionLimit: 5
  });

  await pool.query('SELECT 1');
  console.log('Database connection established');
}

app.get('/health', (req, res) => {
  res.status(200).json({
    status: 'healthy',
    service: 'teamops-api'
  });
});

app.get('/api/status', async (req, res) => {
  try {
    const [rows] = await pool.query(
      'SELECT VERSION() AS mysql_version'
    );

    res.json({
      status: 'healthy',
      database: 'connected',
      mysql_version: rows[0].mysql_version
    });
  } catch (error) {
    res.status(500).json({
      status: 'unhealthy',
      database: 'disconnected'
    });
  }
});

app.get('/api/tasks', async (req, res) => {
  try {
    const [rows] = await pool.query(
      `SELECT id, title, description, status, priority,
              assigned_to, created_by, created_at, updated_at
       FROM tasks
       ORDER BY created_at DESC`
    );

    res.json(rows);
  } catch (error) {
    res.status(500).json({
      error: 'Unable to retrieve tasks'
    });
  }
});

app.post('/api/tasks', async (req, res) => {
  try {
    const {
      title,
      description = null,
      priority = 'medium'
    } = req.body;

    if (!title || !title.trim()) {
      return res.status(400).json({
        error: 'title is required'
      });
    }

    const allowedPriorities = [
      'low',
      'medium',
      'high',
      'critical'
    ];

    if (!allowedPriorities.includes(priority)) {
      return res.status(400).json({
        error: 'invalid priority'
      });
    }

    const [result] = await pool.execute(
      `INSERT INTO tasks
       (title, description, priority)
       VALUES (?, ?, ?)`,
      [title.trim(), description, priority]
    );

    const [rows] = await pool.execute(
      `SELECT *
       FROM tasks
       WHERE id = ?`,
      [result.insertId]
    );

    res.status(201).json(rows[0]);
  } catch (error) {
    res.status(500).json({
      error: 'Unable to create task'
    });
  }
});

app.patch('/api/tasks/:id', async (req, res) => {
  try {
    const id = Number(req.params.id);
    const { status, priority } = req.body;

    const allowedStatuses = [
      'open',
      'in_progress',
      'done'
    ];

    const allowedPriorities = [
      'low',
      'medium',
      'high',
      'critical'
    ];

    if (status && !allowedStatuses.includes(status)) {
      return res.status(400).json({
        error: 'invalid status'
      });
    }

    if (priority && !allowedPriorities.includes(priority)) {
      return res.status(400).json({
        error: 'invalid priority'
      });
    }

    if (!status && !priority) {
      return res.status(400).json({
        error: 'status or priority is required'
      });
    }

    if (status) {
      await pool.execute(
        'UPDATE tasks SET status = ? WHERE id = ?',
        [status, id]
      );
    }

    if (priority) {
      await pool.execute(
        'UPDATE tasks SET priority = ? WHERE id = ?',
        [priority, id]
      );
    }

    const [rows] = await pool.execute(
      'SELECT * FROM tasks WHERE id = ?',
      [id]
    );

    if (rows.length === 0) {
      return res.status(404).json({
        error: 'task not found'
      });
    }

    res.json(rows[0]);
  } catch (error) {
    res.status(500).json({
      error: 'Unable to update task'
    });
  }
});

app.delete('/api/tasks/:id', async (req, res) => {
  try {
    const [result] = await pool.execute(
      'DELETE FROM tasks WHERE id = ?',
      [Number(req.params.id)]
    );

    if (result.affectedRows === 0) {
      return res.status(404).json({
        error: 'task not found'
      });
    }

    res.status(204).send();
  } catch (error) {
    res.status(500).json({
      error: 'Unable to delete task'
    });
  }
});

async function start() {
  try {
    await initialiseDatabase();

    app.listen(4000, '0.0.0.0', () => {
      console.log('TeamOps API listening on port 4000');
    });
  } catch (error) {
    console.error('Application startup failed');
    process.exit(1);
  }
}

start();
NODE

cat > /etc/systemd/system/teamops-api.service <<SERVICE
[Unit]
Description=TeamOps API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/teamops
ExecStart=/usr/bin/node /opt/teamops/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=AWS_REGION=us-east-1
Environment=DB_HOST=${db_endpoint}
Environment=DB_SECRET_ARN=${rds_secret_arn}

[Install]
WantedBy=multi-user.target
SERVICE

chown -R ec2-user:ec2-user /opt/teamops

systemctl daemon-reload
systemctl enable teamops-api
systemctl restart teamops-api